# ---- App ----
APP_NAME=LearnMate-AI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=replace_with_a_random_secret
JWT_SECRET_KEY=replace_with_another_random_secret
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://localhost:8000","http://127.0.0.1","http://127.0.0.1:3000"]

# ---- Database ----
DATABASE_URL=mysql+asyncmy://learnmate:learnmate@mysql:3306/learnmate
DATABASE_SYNC_URL=mysql+pymysql://learnmate:learnmate@mysql:3306/learnmate

MYSQL_ROOT_PASSWORD=learnmate_root_password
MYSQL_PASSWORD=learnmate

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Storage ----
STORAGE_PROVIDER=local
STORAGE_BUCKET=learnmate
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
LOCAL_STORAGE_PATH=./storage

# ---- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@learnmate.ai

# ---- AI Rate Limits ----
AI_LIMIT_TUTOR_PER_DAY=100
AI_LIMIT_VIDEO_PER_DAY=20
AI_LIMIT_QUIZ_PER_DAY=50
AI_LIMIT_NOTES_PER_DAY=50
AI_LIMIT_TEACHER_PER_DAY=200

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=INFO

# ---- Frontend ----
FRONTEND_URL=http://localhost
MAX_VIDEO_UPLOAD_BYTES=524288000


# YouTube Data API (required for YouTube search/channel discovery)
YOUTUBE_API_KEY=
