# Copy this file to .env on the production server, then replace EVERY CHANGE_ME value.
# Never commit .env. Keep permissions restrictive: chmod 600 .env
APP_NAME=LearnMate-AI
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_URL=https://CHANGE_ME_DOMAIN
SERVER_NAME=CHANGE_ME_DOMAIN
CERTBOT_EMAIL=CHANGE_ME_ADMIN_EMAIL

# Generate independently: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_DIFFERENT_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# JSON list format expected by Pydantic settings.
CORS_ORIGINS=["https://CHANGE_ME_DOMAIN"]

# Keep database host as the Compose service name 'mysql'; do not use localhost.
MYSQL_DATABASE=learnmate
MYSQL_USER=learnmate
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD
DATABASE_URL=mysql+asyncmy://learnmate:CHANGE_ME_URL_ENCODED_APP_PASSWORD@mysql:3306/learnmate
DATABASE_SYNC_URL=mysql+pymysql://learnmate:CHANGE_ME_URL_ENCODED_APP_PASSWORD@mysql:3306/learnmate
REDIS_URL=redis://redis:6379/0

# Server-side credentials only. Never expose these as NEXT_PUBLIC_* variables.
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=CHANGE_ME_SUPPORTED_GEMINI_MODEL
YOUTUBE_API_KEY=CHANGE_ME_YOUTUBE_API_KEY_IF_USED
# Optional: hosted transcript fallback when direct YouTube caption requests are blocked.
SUPADATA_API_KEY=

# Choose 's3' only after creating and testing a durable bucket; otherwise configure local storage intentionally.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=CHANGE_ME_PRIVATE_STORAGE_BUCKET
STORAGE_ACCESS_KEY=CHANGE_ME_LEAST_PRIVILEGE_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY
STORAGE_ENDPOINT=
STORAGE_REGION=CHANGE_ME_BUCKET_REGION
LOCAL_STORAGE_PATH=/app/storage
MAX_VIDEO_UPLOAD_BYTES=524288000

# SMTP provider credentials for account verification and password reset.
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@CHANGE_ME_DOMAIN

AI_LIMIT_TUTOR_PER_DAY=100
AI_LIMIT_VIDEO_PER_DAY=20
AI_LIMIT_QUIZ_PER_DAY=50
AI_LIMIT_NOTES_PER_DAY=50
AI_LIMIT_TEACHER_PER_DAY=200

# Optional monitoring. Leave empty only if monitoring is not configured.
SENTRY_DSN=
LOG_LEVEL=INFO
BACKUP_RETENTION_DAYS=14
# Required for public production: configure a separate private off-site backup bucket and least-privilege credentials.
# Staging may leave these empty if local-only backups are acceptable for disposable test data.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=

# Optional fallback used when the primary Gemini model returns 503/UNAVAILABLE
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
