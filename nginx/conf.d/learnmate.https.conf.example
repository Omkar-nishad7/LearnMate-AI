# TLS reference template. Do NOT save as .conf until the certificate files exist.
# Replace YOUR_DOMAIN. Test with `nginx -t` before reloading Nginx.

server {
    listen 80;
    server_name YOUR_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:LearnMateTLS:10m;
    ssl_session_tickets off;

    client_max_body_size 500m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location ~ ^/api/v1/auth/(login|register|forgot-password|reset-password) {
        limit_req zone=auth_zone burst=5 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/conf.d/proxy_common.conf;
    }

    location /api/v1/files {
        limit_req zone=upload_zone burst=5 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/conf.d/proxy_common.conf;
        client_max_body_size 500m;
    }

    location /api/v1/ai/ {
        limit_req zone=api_zone burst=30 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/conf.d/proxy_common.conf;
    }

    location /api/ {
        limit_req zone=api_zone burst=60 nodelay;
        proxy_pass http://backend:8000;
        include /etc/nginx/conf.d/proxy_common.conf;
    }

    location = /health {
        proxy_pass http://backend:8000/api/v1/health;
        include /etc/nginx/conf.d/proxy_common.conf;
    }

    location / {
        proxy_pass http://frontend:3000;
        include /etc/nginx/conf.d/proxy_common.conf;
    }
}
