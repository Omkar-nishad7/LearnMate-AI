# Local environment files and secrets. Keep only non-secret examples tracked.
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Python bytecode, environments, tests and tooling caches.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# JavaScript dependencies, framework build output, and browser-test artifacts.
node_modules/
.next/
out/
dist/
build/
coverage/
playwright-report/
test-results/

# macOS and editor metadata.
.DS_Store
._*
__MACOSX/
.idea/
.vscode/


# Private credentials, key material, and local cloud/registry configuration.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.cert
*.jks
*.keystore
*.p7b
*.p7c
.ssh/
.aws/
.npmrc
.pypirc
.envrc
credentials.json
service-account.json
*.tfstate
*.tfstate.backup

# Runtime data, generated secrets/certificates, logs and local databases.
/storage/
/backups/
/certbot/conf/*
!/certbot/conf/.gitkeep
/certbot/www/*
!/certbot/www/.gitkeep
/nginx/conf.d/learnmate.https.conf
.previous-release
*.log
logs/
*.sqlite
*.sqlite3
ci_test.db
*.sql.gz
*.dump
